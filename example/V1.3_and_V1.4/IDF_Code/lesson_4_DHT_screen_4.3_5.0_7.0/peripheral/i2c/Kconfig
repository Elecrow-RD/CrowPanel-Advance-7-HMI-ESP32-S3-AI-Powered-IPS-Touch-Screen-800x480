menu "Device_i2c"
    config DEVICE_I2C_ENABLED
        bool "Enable I2C functions"

    if DEVICE_I2C_ENABLED
        config I2C_PORT_NUM
            int "I2C Master Port"
            default 0
        config I2C_GPIO_SCL
            int "GPIO For I2C SCL"
            default 16
        config I2C_GPIO_SDA
            int "GPIO For I2C SDA"
            default 15
        config I2C_GPIO_SCL_PULLUP
            bool "Enable SCL Pullup resistor"
            default false
        config I2C_GPIO_SDA_PULLUP
            bool "Enable SDA Pullup resistor"
            default false
        config I2C_MASTER_FREQUENCY
            int "I2C Clock frequency"
            default 400000
        config I2C_BUS_TIMEOUT
            int "Wait for response (ms)"
            default 200
    endif
endmenu